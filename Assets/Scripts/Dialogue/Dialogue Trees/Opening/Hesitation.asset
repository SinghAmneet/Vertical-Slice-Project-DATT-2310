  m_Script: {fileID: 11500000, guid: a13b7d098f7567f4490ad5c502ee1994, type: 3}
  m_Name: Hesitation
  m_EditorClassIdentifier: 
  dialogueLines:
  - speaker: 2
    speech: 0
    va: {fileID: 8300000, guid: cba7119797288874ca4481cd401c3684, type: 3}
    dialogue: 'Why do you keep silent? [Pause:0.8]

      Are you scared?'
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 1
    va: {fileID: 8300000, guid: 12d3386143593a140933047a67150fc2, type: 3}
    dialogue: '[Pause:0.8]Of course I am, you[Pause:0.2] overgrown[Pause:0.2] golden
      peacock!'
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 0
    va: {fileID: 8300000, guid: c7ec6ae5031a3bc49908b34f9b5fc9f8, type: 3}
    dialogue: "[Pause:0.5]No, sir.[Pause:0.1][Rate:0.04] I\u2019m just worried you
      might be [Rate:0.07]poisoned[Rate:Default] by the monster meat. "
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 1
    va: {fileID: 8300000, guid: 9198a1e7091141b488d700b7f4159764, type: 3}
    dialogue: '[Rate:0.065]I do not get paid enough to do this.'
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 0
    va: {fileID: 8300000, guid: c91307fbe3fd7634e9e2ec01b6b73c01, type: 3}
    dialogue: "[Pause:0.75]I don\u2019t care,[Pause:0.2] you must know because I
      know that you know."
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 0
    va: {fileID: 8300000, guid: ad2dd71a1a02dbe48917d43836c47dea, type: 3}
    dialogue: '[Pause:1]Six[Rate:0.3]... [Rate:Default]seven[Rate:0.3]...'
    startAction: {fileID: 11400000, guid: 6596f639ab61a1743b4d88effa6393da, type: 2}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 0
    va: {fileID: 8300000, guid: 1f9446d0d858ab7419f372aa436001a8, type: 3}
    dialogue: '[Pause:0.8][Rate:0.05]What?'
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 0
    va: {fileID: 8300000, guid: 7fa85284eb92cb1438ea2659c4863a41, type: 3}
    dialogue: '[Pause:0.5] [Rate:0.09]I''m[Rate:Default] [Pause:0.4]counting my savings.'
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 0
    va: {fileID: 8300000, guid: 2bea50f32c758b44881b47258832b970, type: 3}
    dialogue: '[Pause:0.3]What for?'
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 0
    va: {fileID: 8300000, guid: 904b079078823f74f8db1f42b95007d8, type: 3}
    dialogue: "[Pause:0.4]So if I [Rate:0.07]die [Rate:0.05][Pause:0.1]during the
      expedition, [Pause:0.1]at least my family will have some support after I\u2019m
      gone."
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 0
    va: {fileID: 8300000, guid: 9a7f98a565f0de94e8b1c5c70d0fac38, type: 3}
    dialogue: "[Pause:0.6]Don\u2019t worry about that! [Pause:0.1]\nI\u2019ll take
      care of them."
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  endChoices:
  - choiceDialogue: Like I can believe you.
    choiceDialogueTree: {fileID: 11400000, guid: 3ad6e33e93716fc42aa18efee4db8001, type: 2}
