  m_Name: R3-Evaluation
  m_EditorClassIdentifier: 
  dialogueLines:
  - speaker: 0
    speech: 0
    va: {fileID: 0}
    dialogue: 'Kenny pauses, taking in the scene: Flint nervous, Evelyn watching,
      and the dessert before him. He clenches his jaw but restrains himself.'
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 1
    va: {fileID: 0}
    dialogue: " I risked my life for this kingdom\u2026 for her\u2026 and yet, here
      I stand. But perhaps now is not the time for revenge.\r\n"
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 1
    va: {fileID: 0}
    dialogue: ' Patience, Kenny. Loyalty above all. Say nothing. Do nothing.'
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 0
    va: {fileID: 0}
    dialogue: ' Your Majesty, the dish is ready for your table.'
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  endChoices: []
  nextTree: {fileID: 0}
