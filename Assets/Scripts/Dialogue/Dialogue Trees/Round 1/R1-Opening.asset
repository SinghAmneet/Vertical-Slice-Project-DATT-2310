  dialogueLines:
  - speaker: 2
    speech: 0
    va: {fileID: 0}
    dialogue: "Chef Kenny, you\u2019ve returned?"
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 0
    va: {fileID: 0}
    dialogue: 'You look dreadful! Have you been dragged through the wilds?

'
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 1
    va: {fileID: 0}
    dialogue: Deadful? I nearly died out there!
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 1
    va: {fileID: 0}
    dialogue: "I\u2019m a chef, not a soldier \u2013 You sent me to Elixir with no
      supplies, no escort\u2026nothing! Hello?"
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 1
    va: {fileID: 0}
    dialogue: 'Yes, your Majesty. This is Basilisk Egg Crunch Bowl. I trust it will
      please your palate.

'
    startAction: {fileID: 0}
    endAction: {fileID: 0}
