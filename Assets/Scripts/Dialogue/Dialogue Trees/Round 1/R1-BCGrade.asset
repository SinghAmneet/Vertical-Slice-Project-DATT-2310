    va: {fileID: 8300000, guid: 2a35928406259ff47b457c5bc2cfeca1, type: 3}
    dialogue: It neither delights nor offends
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 0
    va: {fileID: 8300000, guid: 24282d67ac1ddd54e8f3f1a4a3e4d4e5, type: 3}
    dialogue: 'Take this payment and go. I expect far greater things from your next
      creation.

'
