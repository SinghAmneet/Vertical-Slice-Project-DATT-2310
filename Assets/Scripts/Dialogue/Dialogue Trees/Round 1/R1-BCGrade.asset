    endAction: {fileID: 0}
  - speaker: 1
    speech: 0
    va: {fileID: 8300000, guid: 519d5d1887ab37744909eb71ed41f0ea, type: 3}
    dialogue: "As you wish, Your Majesty. I shall return\u2026 better prepared.\r\n"
