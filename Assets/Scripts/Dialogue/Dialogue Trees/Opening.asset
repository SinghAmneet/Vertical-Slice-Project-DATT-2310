    dialogue: " [Rate:0.5]\u2026[Rate:Default]Your Majesty?"
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 0
    dialogue: Beyond the outer border lies Elixir, they say monsters roam freely
      there. [Rate:0.4]Go. [Rate:Default]Bring me something extraordinary!
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  endChoices:
