  m_Name: Hesitation
  m_EditorClassIdentifier: 
  dialogueLines:
  - speaker: 2
    speech: 0
    dialogue: 'Why do you keep silent? [Pause:0.5]

      Are you scared?'
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 1
    dialogue: Of course I am, you overgrown golden peacock!
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 0
    dialogue: "No, sir. I\u2019m just worried you might be poisoned by the monster
      meat. "
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 1
    dialogue: I do not get paid enough to do this.
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 0
    dialogue: "I don\u2019t care, you must know because I know that you know."
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 0
    dialogue: Six[Rate:0.3]... [Rate:Default]seven[Rate:0.3]...
    startAction: {fileID: 11400000, guid: 6596f639ab61a1743b4d88effa6393da, type: 2}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 0
    dialogue: ' [Rate:0.1]What?'
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 0
    dialogue: I'm counting my savings.
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 0
    dialogue: What for?
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 0
    dialogue: "So if I die during the expedition, at least my family will have some
      support after I\u2019m gone."
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 0
    dialogue: "Don\u2019t worry about that! [Pause:0.5]\nI\u2019ll take care of them."
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  endChoices:
  - choiceDialogue: Like I can believe you.
