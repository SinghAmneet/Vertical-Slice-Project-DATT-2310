  m_Script: {fileID: 11500000, guid: a13b7d098f7567f4490ad5c502ee1994, type: 3}
  m_Name: R2-Opening
  m_EditorClassIdentifier: 
  dialogueLines:
  - speaker: 2
    speech: 0
    va: {fileID: 0}
    dialogue: "Aha! Come, tell me\u2014what masterpiece graces our table this evening?"
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 0
    va: {fileID: 0}
    dialogue: "It carries my sweat\u2026 and blood. Literally. I trust it will satisfy,
      Your Majesty."
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 0
    va: {fileID: 0}
    dialogue: During my expedition, I encountered a pant moonfish
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 0
    va: {fileID: 0}
    dialogue: "\u2026A what?"
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 0
    va: {fileID: 0}
    dialogue: "A fish wearing trousers, sire. I pan-fried it with a touch of morning
      oil and\u2026body salt.\r\n"
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 0
    va: {fileID: 0}
    dialogue: "Are its pants \u2026 optional?"
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 0
    va: {fileID: 0}
    dialogue: "Sadly, Your Majesty, no. They\u2019ve been part of its flavour since
      birth"
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  endChoices: []
  nextTree: {fileID: 11400000, guid: 61a064a3f3bff3047abea4afd5ab4dea, type: 2}
