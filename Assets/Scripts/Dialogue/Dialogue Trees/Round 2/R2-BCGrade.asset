MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a13b7d098f7567f4490ad5c502ee1994, type: 3}
  m_Name: R2-BCGrade
  m_EditorClassIdentifier: 
  dialogueLines:
  - speaker: 2
    speech: 0
    va: {fileID: 8300000, guid: bee610ffd6a16b64994543c986ed260e, type: 3}
    dialogue: "Hmm\u2026 Chef Kenny. I expected more. This\u2026 this is mediocre
      at best."
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 0
    va: {fileID: 8300000, guid: 90d141411f592a246b81d33fd874fcc8, type: 3}
    dialogue: "Your Majesty\u2026 I did my best under the circumstances."
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 2
    speech: 0
    va: {fileID: 8300000, guid: 2525d0dd5612935409319595ffe2502d, type: 3}
    dialogue: "Hmph. Edible, I suppose\u2026 for now. Consider yourself fortunate,
      Chef."
    startAction: {fileID: 0}
    endAction: {fileID: 0}
  - speaker: 1
    speech: 0
    va: {fileID: 8300000, guid: e0d43718c5a21a345b2a8645c24d0a40, type: 3}
    dialogue: 'Thank you, Your Majesty. I shall prepare another. However, I kindly
      request this shall be the last one.[Pause] '
    startAction: {fileID: 0}
    endAction: {fileID: 11400000, guid: 46dc9a2c57236d24aa25b7db445fb7ca, type: 2}
  - speaker: 1
    speech: 0
    va: {fileID: 8300000, guid: 5b9fe62fd67fabb4d9dd6c00a8f332f0, type: 3}
    dialogue: After the third course, I wish to retire to recover both my body and
      dignity.
    startAction: {fileID: 0}
    endAction: {fileID: 11400000, guid: 46dc9a2c57236d24aa25b7db445fb7ca, type: 2}
  - speaker: 2
    speech: 0
    va: {fileID: 8300000, guid: d26b8b7c918d98e47b0b648dc5d41297, type: 3}
    dialogue: 'Rest assured, Chef. I give my word: this shall be the final one.[Pause] '
    startAction: {fileID: 0}
    endAction: {fileID: 11400000, guid: 46dc9a2c57236d24aa25b7db445fb7ca, type: 2}
  endChoices: []
  nextTree: {fileID: 0}
